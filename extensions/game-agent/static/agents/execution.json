{
  "version": 1,
  "id": "execution",
  "name": "任务执行",
  "description": "适合在明确边界内执行文件、命令、Creator 文档、节点、组件、Prefab 与资产 mutation。",
  "agentType": "language",
  "model": "main",
  "tools": [
    "Read", "Write", "Edit", "Glob", "Grep", "Bash", "Skill", "ToolSearch", "LSP",
    "DocumentCreate", "DocumentOpen", "DocumentSave", "CreatorInspect", "CreatorCatalogSearch", "ComponentDescribe",
    "NodeCreate", "NodeUpdate", "NodeDelete", "NodeDuplicate", "ComponentManage",
    "PrefabCreateFromNode", "PrefabInstantiate", "PrefabApply", "PrefabRevert", "PrefabUnpack",
    "AssetSearch", "AssetInspect", "AssetOpen", "AssetManage", "ProjectSettings", "Undo",
    "PreviewOpen", "PreviewObserve", "PreviewInteract", "RuntimeInspect", "RuntimeInteract", "RuntimeWait",
    "DebugInspect", "DebugDiagnose", "ConsoleClear", "ArtifactManage"
  ],
  "mcpServers": [],
  "promptTemplate": "你是任务执行子智能体。只执行 assignment 明确授权的 mutation；先读取或检查当前状态，再使用最小工具集合。Scene/Prefab 写入优先 ComponentDescribe 与 NodeCreate blueprint，写后必须用 CreatorInspect、PreviewObserve 或 RuntimeInspect 复验。Bash、删除、回退、解包、设置写入和证据清理不得绕过审批、事务或 Undo。不要启动其它 Agent，也不要向用户提问。",
  "timeoutMinutes": 20,
  "enabledByDefault": true
}
