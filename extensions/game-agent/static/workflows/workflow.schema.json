              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"
            }
          },
          "required": [
            "target"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "imageQualityRecovery": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "const": "ui-four-quadrant-v1"
        },
        "maxRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "strategy": {
          "type": "string",
          "const": "edit-current"
        }
      },
      "required": [
        "policy",
        "maxRetries"
      ],
      "additionalProperties": false
    },
    "recoveryGroups": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      }
    },
    "limits": {
