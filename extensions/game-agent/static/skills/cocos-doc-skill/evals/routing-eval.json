{
  "id": "cocos-doc-skill-routing-eval",
  "version": 1,
  "creator_version": "3.8",
  "updated": "2026-08-03",
  "purpose": "评估 cocos-doc-skill 对 Cocos Creator 3.8 常见问法的路由召回、回答契约和编辑器/运行时边界意识。",
  "validation_commands": [
    "npm run cocos-doc-skill:validate:full",
    "git diff --check"
  ],
  "routing_source": "scripts/cocos-doc-skill/regression-prompts.json",
  "pass_criteria": {
    "routing_hit_rate_min": 0.8,
    "must_read_doc_before_answer": true,
    "must_warn_on_needs_review": true,
    "must_distinguish_runtime_editor_import_build_extension": true
  },
  "suites": [
    {
      "id": "routing-smoke",
      "type": "routing",
      "cases": [
        {
          "query": "动画播完之后没有回调",
          "expected_any": [
            "troubleshooting/animation-event-not-fired.md",
            "recipes/animation-event-callback.md"
          ]
        },
        {
          "query": "Widget停靠对齐",
          "expected_any": [
            "ui-2d/widget.md",
            "recipes/screen-adaptation.md"
          ]
        },
        {
          "query": "Collider2D 碰撞器",
          "expected_any": [
            "api-reference/collider-2d.md",
            "recipes/detect-collision-2d.md"
          ]
        },
        {
          "query": "编辑器扩展脚本 Editor.Message 怎么用",
          "expected_any": [
            "scripting/script-types-and-loading.md"
          ]
        },
        {
          "query": "Bundle 分包机制",
          "expected_any": [
            "assets/asset-bundle.md",
            "assets/subpackage.md"
          ]
        },
        {
          "query": "RenderTexture Android blendState 报错",
          "expected_any": [
            "troubleshooting/render-texture-blend-state.md"
          ],
          "must_warn_needs_review": true
        },
        {
          "query": "插件资源库和 db://assets 有什么区别",
          "expected_any": [
            "concepts/project-structure.md"
          ]
        },
        {
          "query": ".meta 保存什么",
          "expected_any": [
            "concepts/asset-meta-uuid.md"
          ],
          "forbidden": [
            "assets/meta-uuid.md"
          ]
        },
        {
          "query": "meta 丢失怎么恢复",
          "expected_any": [
            "assets/meta-uuid.md"
          ],
          "forbidden": [
            "concepts/asset-meta-uuid.md"
          ]
        }
      ]
    },
    {
      "id": "answer-contract",
      "type": "manual-review",
      "cases": [
        {
          "query": "如何在属性检查器里绑定 Label 并改文字？",
          "checks": [
            "区分编辑器属性绑定和运行时代码",
            "TypeScript 示例从 cc import",
            "组件引用声明为 Label | null 并判空",
            "引用 label/api-reference 或 scripting/ccclass-property 相关文档"
          ]
        },
        {
          "query": "Cocos Creator 3.8 微信小游戏包体过大怎么办？",
          "checks": [
            "命中 build-wechat-game 或 package-too-large",
            "说明平台限制可能变化",
            "needs-review 文档必须提示复核"
          ]
        },
        {
          "query": "怎么判断这是运行时代码、编辑器扩展脚本还是构建面板配置问题？",
          "checks": [
            "明确运行时脚本、编辑器扩展、资源导入、构建发布四类环境",
            "建议先用 route-query/search-docs 定位文档",
            "不把 Editor.* API 当作运行时代码"
          ]
        }
      ]
    }
  ],
  "latest_verified_result": {
    "date": "2026-08-03",
    "routing_regression": {
      "total": 116,
      "hit": 116,
      "hit_rate": 1
    },
    "public_export_enhanced_hit_rate": 1,
    "full_validation": "pass",
    "known_warnings": [
      "routing aggregate file budget warnings remain because aggregate JSON files are generated entrypoints over split shards",
      "MD_OVERSIZED_FILE warnings remain for pre-existing 200-line soft budget docs; all docs are below the 300-line hard limit"
    ]
  }
}
